# Backend configuration for MERN Email Validator
# Copy this file to .env and adjust values for your environment.

# Server port
PORT=5000

# Application log level (pino): trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Allowed CORS origins (comma-separated). Leave empty to allow all (not recommended in production).
# Example: CORS_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Bulk validation limits
MAX_BULK=100
CONCURRENCY=10

# DNS lookup timeout in milliseconds
DNS_TIMEOUT_MS=5000
CACHE_TTL_MS=300000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional API key. If set, clients must send an `x-api-key` header.
# API_KEY=your-secret-key-here
